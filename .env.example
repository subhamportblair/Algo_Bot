# Kite Connect Environment Variables

# API Key and Secret from Kite Connect developer portal
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Access Token (obtained daily via the login flow)
KITE_ACCESS_TOKEN=your_access_token

# Trading Symbol and Exchange
TRADING_SYMBOL=INFY
TRADING_EXCHANGE=NSE
